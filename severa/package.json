{
  "name": "severa",
  "version": "0.1.0",
  "private": true,
  "main": "dist/infrastructure/config/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/infrastructure/config/server.ts",
    "build": "npm run lint:deps && tsc -p tsconfig.json",
    "start": "node dist/infrastructure/config/server.js",
    "migrate": "node scripts/migrate.js",
    "test": "jest",
    "test:domain": "jest --runInBand tests/domain",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "lint:deps": "depcruise --config .dependency-cruiser.js src --validate"
  },
  "dependencies": {
    "axios": "^1.6.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "dependency-cruiser": "^18.0.0",
    "jest": "^29.7.0",
    "nock": "^14.0.16",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
