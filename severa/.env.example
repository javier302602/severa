DATABASE_URL=postgresql://postgres:postgres@localhost:5432/severa_dev
# Ejemplo generado con `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# — es un valor VÁLIDO en formato (96 caracteres hex, alta entropía) pero es
# público porque está en este archivo de ejemplo. NUNCA lo uses tal cual en
# producción: generá el tuyo con el mismo comando (o equivalente) antes de
# desplegar, y no lo commitees en .env.example ni en ningún otro lado.
JWT_SECRET=a60bc56d9fd746df2b04e0766656c6aada33967368343fe8459a4f1739e017bea2bf3478595c7463c1bdae5ae8219ac4
NVD_API_KEY=your_nvd_api_key_here
NVD_API_BASE_URL=https://api.nvd.nist.gov
PORT=3000
# RF-93: en cualquier valor distinto de 'development' se exige HTTPS en todas las rutas.
# Este docker-compose.yml básico NO incluye un proxy que termine TLS
# (nginx/Traefik), así que se mantiene 'development' para que la prueba de
# extremo a extremo funcione por HTTP plano — ver huecos reportados.
NODE_ENV=development
# Origen exacto del frontend (esquema + host + puerto, sin barra final) —
# sin esto ningún navegador puede llamar a la API por CORS. Default al
# puerto por defecto de `npm run dev` en frontend/ (Vite).
CORS_ORIGIN=http://localhost:5173
